{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReadRay",
  "version": "0.1.0",
  "identifier": "com.readray.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReadRay",
        "url": "index.html?view=main",
        "width": 1180,
        "height": 760,
        "minWidth": 840,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": true,
        "skipTaskbar": false,
        "shadow": true
      },
      {
        "label": "overlay",
        "title": "ReadRay Overlay",
        "url": "index.html",
        "width": 720,
        "height": 104,
        "minWidth": 680,
        "minHeight": 90,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
